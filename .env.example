# Copy to .env and fill in. Local dev values shown as hints.

# Postgres. Local dev uses the docker container on port 5434; in production
# point this at your Neon pooled connection string.
DATABASE_URL=postgresql://postgres:devpass@localhost:5434/networking_cal

# Auth.js — generate with `npx auth secret`
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Single-user gate
DEV_LOGIN_PASSWORD=dev
ALLOWED_EMAIL=you@gmail.com

# Guards the /api/cron/run trigger endpoint
CRON_SECRET=

# No model API key: discovery + curation are done by the scheduled Claude Code
# scout itself (see runner/SCOUT.md), using its own web search.

# --- Google: calendar push + gmail send (one grant) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=primary
DIGEST_TO_EMAIL=
